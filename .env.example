# Nunca subas el archivo .env con tu clave.
OPENAI_API_KEY=pega_aqui_tu_clave
OPENAI_MODEL=gpt-4o-mini

# URL del servidor MCP (local por defecto; en producción apunta al servicio remoto, ej. Azure Container Apps).
AGENT_MCP_URL=http://127.0.0.1:8000/sse

# Ventana de memoria: cuántos mensajes recientes (+ el mensaje inicial) viajan al LLM en cada turno.
MEMORY_WINDOW_MESSAGES=8

# Credenciales CIE-11 API
ICD_CLIENT_ID=pega_client_id_de_cie11
ICD_CLIENT_SECRET=pega_clientsecret_de_cie11
