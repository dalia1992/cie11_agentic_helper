# Nunca subas el archivo .env con tu clave.
OPENAI_API_KEY=pega_aqui_tu_clave
OPENAI_MODEL=gpt-5.4-nano

# URLs locales de los dos MCP remotos.
AGENT_MCP_URL=http://127.0.0.1:8000/mcp

# Ventana pedagógica de memoria: conserva el mensaje inicial y los últimos N mensajes.
MEMORY_WINDOW_MESSAGES=8

# Credenciales CIE-11 API
ICD_CLIENT_ID=pega_client_id_de_cie11
ICD_CLIENT_SECRET=pega_clientsecret_de_cie11
